KYLIN_AIOPS_API_URL=https://ops-center.example.internal:8443
KYLIN_AIOPS_NODE_ID=app-01
KYLIN_AIOPS_TOKEN=replace-with-enrolled-agent-token
KYLIN_AIOPS_ACTION_SIGNING_SECRET=replace-with-center-action-signing-secret
KYLIN_AIOPS_CA_FILE=/etc/kylin-aiops/pki/ca.pem
KYLIN_AIOPS_CERT_FILE=/etc/kylin-aiops/pki/agent.pem
KYLIN_AIOPS_KEY_FILE=/etc/kylin-aiops/pki/agent-key.pem
KYLIN_AIOPS_INTERVAL_SECONDS=10
